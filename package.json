{
  "name": "agentdesk",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@a2ui/react": "0.10.2",
    "@a2ui/web_core": "0.10.6",
    "dompurify": "3.4.13"
  },
  "overrides": {
    "dompurify": "$dompurify"
  },
  "scripts": {
    "setup": "npm install --workspaces --include-workspace-root && python scripts/setup.py",
    "dev": "python scripts/dev.py",
    "dev:api": "python scripts/run_python.py -m uvicorn agents.coordinator.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:hello": "python scripts/run_python.py -m uvicorn agents.hello.main:app --reload --host 127.0.0.1 --port 8004",
    "dev:research": "python scripts/run_python.py -m uvicorn agents.researcher.main:app --reload --host 127.0.0.1 --port 8005",
    "dev:analyst": "python scripts/run_python.py -m uvicorn agents.analyst.main:app --reload --host 127.0.0.1 --port 8006",
    "dev:verifier": "python scripts/run_python.py -m uvicorn agents.verifier.main:app --reload --host 127.0.0.1 --port 8007",
    "hello": "python scripts/run_python.py -m agents.hello.client",
    "hello:stream": "python scripts/run_python.py -m agents.hello.stream_client",
    "dev:web": "npm run dev --workspace @agentdesk/web",
    "lint:python": "python scripts/run_python.py -m ruff check . && python scripts/run_python.py -m ruff format --check agents packages scripts tests",
    "lint:web": "npm run lint --workspace @agentdesk/web",
    "lint": "npm run lint:python && npm run lint:web",
    "typecheck:python": "python scripts/run_python.py -m mypy",
    "typecheck:web": "npm run typecheck --workspace @agentdesk/web",
    "typecheck": "npm run typecheck:python && npm run typecheck:web",
    "test:python": "python scripts/run_python.py -m pytest",
    "test:a2a": "python scripts/run_python.py -m pytest -m a2a_contract",
    "test:agui:python": "python scripts/run_python.py -m pytest -m agui_contract",
    "test:agui": "npm run test:agui:python && npm run test:agui --workspace @agentdesk/web",
    "test:e2e": "npm run test:e2e --workspace @agentdesk/web",
    "test:e2e:demo": "npm run test:e2e:demo --workspace @agentdesk/web",
    "test:e2e:intake": "npm run test:e2e:intake --workspace @agentdesk/web",
    "test:web": "npm test --workspace @agentdesk/web",
    "test": "npm run test:python && npm run test:web",
    "build": "npm run build --workspace @agentdesk/web"
  }
}
