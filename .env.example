# Specialist discovery endpoints used by the Coordinator
RESEARCH_AGENT_URL=http://127.0.0.1:8005
ANALYST_AGENT_URL=http://127.0.0.1:8006
VERIFIER_AGENT_URL=http://127.0.0.1:8007
AGENTDESK_REGISTRY_TIMEOUT_SECONDS=5
AGENTDESK_REGISTRY_MAX_ATTEMPTS=3
AGENTDESK_REGISTRY_RETRY_DELAY_SECONDS=0.1

# Authentication: local accepts requests without credentials; token requires both secrets.
AGENTDESK_AUTH_MODE=local
AGENTDESK_BROWSER_TOKEN=
AGENTDESK_SERVICE_TOKEN=
AGENTDESK_BROWSER_PRINCIPAL_ID=authenticated-browser
AGENTDESK_LOCAL_PRINCIPAL_ID=local-development

# Coordinator planning provider (required for production orchestration)
OPENAI_API_KEY=
AGENTDESK_COORDINATOR_MODEL=

# Browser-to-Coordinator AG-UI endpoint (relative or HTTP(S); defaults to /ag-ui)
VITE_AGENTDESK_AG_UI_ENDPOINT=/ag-ui

# Persistence (introduced in AD-050)
DATABASE_URL=postgresql+psycopg://agentdesk:agentdesk@localhost:5432/agentdesk

# Distributed tracing (disabled for local development unless explicitly enabled)
AGENTDESK_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
AGENTDESK_TRACING_TIMEOUT_SECONDS=10

