{
  "name": "@agentdesk/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "biome lint --error-on-warnings src test vite.config.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "test:contracts": "node --test test/agui-contract-fixtures.test.mjs test/component-catalog.test.mjs test/frontend-pipeline.test.mjs",
    "test": "node --test test/*.test.mjs && npm run typecheck"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.58",
    "@ag-ui/core": "0.0.58",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.0.16"
  }
}
