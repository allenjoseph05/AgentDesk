# syntax=docker/dockerfile:1

ARG NODE_VERSION=24.17.0
FROM node:${NODE_VERSION}-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci --workspaces --include-workspace-root

COPY apps/web ./apps/web
ARG VITE_AGENTDESK_AG_UI_ENDPOINT=/ag-ui
ARG VITE_AGENTDESK_ADAPTIVE_INTAKE_ENABLED=false
ARG VITE_AGENTDESK_RUNTIME_MODE=demo
ENV VITE_AGENTDESK_AG_UI_ENDPOINT=${VITE_AGENTDESK_AG_UI_ENDPOINT} \
    VITE_AGENTDESK_ADAPTIVE_INTAKE_ENABLED=${VITE_AGENTDESK_ADAPTIVE_INTAKE_ENABLED} \
    VITE_AGENTDESK_RUNTIME_MODE=${VITE_AGENTDESK_RUNTIME_MODE}
RUN npm run build --workspace @agentdesk/web

FROM node:${NODE_VERSION}-bookworm-slim AS runtime

ENV NODE_ENV=production \
    PORT=10000
WORKDIR /app

COPY --from=build --chown=node:node /app/apps/web/dist ./dist
COPY --chown=node:node apps/web/production-server.mjs ./production-server.mjs

USER node
EXPOSE 10000

CMD ["node", "production-server.mjs"]
